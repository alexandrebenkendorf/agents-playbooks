#!/usr/bin/env bash
# Pre-push: have Codex review the commits being pushed; block when it reports
# findings (lines like "- [P2] ...") or fails to run.
# Enable once per clone: git config core.hooksPath .githooks
# Runs local checks first (format, shell syntax, tests), then the Codex review.
# Requires: codex CLI (logged in) and node/npx. shellcheck is used when installed.
# Bypass the review only: SKIP_CODEX_REVIEW=1 git push; the local checks always run.
set -u

# Local checks (run against the working tree)
echo "pre-push: running local checks"
npx --yes prettier@3 --check . >/dev/null 2>&1 || { echo "pre-push: format check failed; run 'npx prettier@3 --write .'"; exit 1; }
bash -n .githooks/pre-push || exit 1
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck .githooks/pre-push || exit 1
fi
node --test skills/frontend/module-federation/scripts/tests/*.test.js >/dev/null 2>&1 || { echo "pre-push: node tests failed; run 'node --test skills/frontend/module-federation/scripts/tests/*.test.js'"; exit 1; }

[ "${SKIP_CODEX_REVIEW:-}" = "1" ] && { echo "pre-push: Codex review skipped"; exit 0; }
command -v codex >/dev/null 2>&1 || { echo "pre-push: codex CLI not found (install it or SKIP_CODEX_REVIEW=1)"; exit 1; }

ZERO=0000000000000000000000000000000000000000
PROMPT='Review these changes for correctness bugs, broken references, and violations of AGENTS.md. Be concise.'
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: compare against the default branch's merge-base
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    [ -z "$base" ] && base=$(git hash-object -t tree /dev/null) # no shared history: review everything
  else
    base=$remote_sha
    if ! git cat-file -e "$base^{commit}" 2>/dev/null; then
      echo "pre-push: remote tip $base is missing locally; run 'git fetch' and retry (or SKIP_CODEX_REVIEW=1)"
      status=1
      continue
    fi
  fi
  [ "$base" = "$local_sha" ] && continue

  echo "pre-push: Codex reviewing $(git rev-parse --short "$base")..$(git rev-parse --short "$local_sha")"
  diff=$(git diff "$base" "$local_sha")
  out=$(printf '%s\n\n%s\n' "$PROMPT" "$diff" | codex review - 2>&1)
  rc=$?
  # Final review text only (after the last "codex" marker); empty if the marker is missing
  final=$(echo "$out" | awk '/^codex$/{buf=""; seen=1; next} {buf=buf $0 "\n"} END{if (seen) printf "%s", buf}')
  echo "$final" | tail -60

  # Pass only if the review ran, produced a final result, and has no [P0]-[P3] finding at any indent
  if [ $rc -ne 0 ] || [ -z "$final" ] || echo "$final" | grep -qE '^[[:space:]]*(- )?\[P[0-3]\]'; then
    echo "pre-push: Codex review did not pass; push blocked (SKIP_CODEX_REVIEW=1 to override)"
    status=1
  fi
done

exit $status
